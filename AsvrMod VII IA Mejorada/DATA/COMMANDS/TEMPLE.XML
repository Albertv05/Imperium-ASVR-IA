<commands>

<!-- TEMPLE COMMANDS -->
<!-- NOTE : train command must have names like this:"trainClassName" -->
<!--        where ClassName is the class of the unit to be trained -->

<cmd name="Punto de reunion" priority="1"
    researchcommand="yes"
    method="punto"
    button="actions/Punto.bmp"
    key="j"
    costgold="0"
    execdelay="0"
    queueicon="gameres/icons/upgrades/Punto.bmp"
    rollover="Definir punto de reunion"
    description="Selecciona el punto en que los guerreros reclutados se reunen"
    param="ReqSet,NameSet">
   <src obj="RTemple"/>
   <src obj="CTemple"/>
   <src obj="ITemple"/>
   <src obj="MTemple"/>
</cmd>

<cmd name="Anular punto de reunion" priority="1"
    researchcommand="yes"
     method="anul_punto"
     button="actions/Anular Punto.bmp"
     groupverifier="data/subai/anular_punto_verify.vs"
     key="x"
     costgold="0"
     execdelay="0"
     queueicon="gameres/icons/upgrades/Punto.bmp"
     rollover="Anular punto de reunion"
     description="Anula el punto en que los guerreros se reunen y los manda al foro."
     param="ReqSet,NameSet">
    <src obj="RTemple"/>
    <src obj="CTemple"/>
    <src obj="ITemple"/>
    <src obj="MTemple"/>
</cmd>

<cmd name="repair temple" priority="1"
	method="repair"
	button="actions/repair.bmp"
	key="r"
	queueicon="gameres/icons/upgrades/repair.bmp"
	groupverifier="data/subai/verify_cmdcost_building.vs"
	rollover="Repair"
	costgold="500"
	costfood="0"
	execdelay = "60000">
	<src obj="RTemple"/>
	<src obj="MTemple"/>
</cmd>

<cmd name="trainRPriest" priority="1"
	button="actions/train RPriest.bmp"
	queueicon="gameres/icons/RPriest.bmp"
	groupverifier="data/subai/verify_cmdcost_building.vs"
	traincommand="yes"
	transpicon="1"
	key="p"
	help="/contents/units/RPriest"
	costgold = "500"
	costfood = "0"
	costpop = "1"
	execdelay = "20000"
	rollover="Call Priest"
	method="train"
	param="RPriest"
	sclass="RPriest">
	<src obj="RTemple"/>
	<src obj="MTemple"/>
</cmd>

<cmd name="Altar of Jupiter" priority="2"
	button="research/priest enlightment.bmp"
	key="a"
	queueicon="gameres/icons/upgrades/Priest Enlighment.bmp"
	researchcommand="yes"
	groupverifier="data/subai/verify_research.vs"
	costgold = "1000"
	costfood = "0"
	execdelay = "15000"
	rollover="Altar de los dioses"
	description="All new priests are level 4"
	method="research"
	param="NameSet, Altar of Jupiter, default, SetsSet, levels/RPriest, 4">
	<src obj="RTemple"/>
	<src obj="MTemple"/>
</cmd>

<cmd name="Cloud of Plague" priority="5"
	queueicon="gameres/icons/upgrades/mist.bmp"
	button="research/mist.bmp"
	key="c"
	researchcommand="yes"
	groupverifier="data/subai/verify_research.vs"
	costgold = "2000"
	costfood = "0"
	execdelay = "20000"
	rollover="Cloud of Plague"
	description="Allows priests to sacrifice themselves to create a cloud of plague which damages all warriors it covers"
	method="research"
	param="ReqSet, Altar of Jupiter, default, NamePlr, Cloud of Plague, default">
	<src obj="RTemple"/>
	<src obj="MTemple"/>
</cmd>

<cmd name="Wrath of Marte" priority="6"
	button="actions/iramarte.bmp"
	queueicon="gameres/icons/upgrades/iramarte.bmp"
	key="m"
	researchcommand="yes"
	groupverifier="data/subai/verify_research.vs"
	costgold = "2000"
	costfood = "0"
	execdelay = "20000"
	rollover="Ritual de la Voluntad de Marte"
	description="Resta vida a hasta 50 enemigos cercanos, la cantidad de vida eliminada aumenta con el nivel (sacrifica la vida del sacerdote en el proceso)"
	method="research"
	param="ReqSet, Altar of Jupiter, default, NamePlr, Wrath of Marte, default">
	<src obj="RTemple"/>
	<src obj="MTemple"/>
</cmd>

<cmd name="Wrath of Jupiter" priority="6"
	button="research/Jupiter.bmp"
	queueicon="gameres/icons/upgrades/Jupiter.bmp"
	key="j"
	researchcommand="yes"
	groupverifier="data/subai/verify_research.vs"
	costgold = "2000"
	costfood = "0"
	execdelay = "20000"
	rollover="Wrath of Jupiter"
	description="Strikes a nearby enemy with lightning every time a priest dies"
	method="research"
	param="ReqSet, Altar of Jupiter, default, NamePlr, Wrath of Jupiter, default">
	<src obj="RTemple"/>
	<src obj="MTemple"/>
</cmd>

<cmd name="God's Gift" priority="7"
	button="research/Gift of God.bmp"
	queueicon="gameres/icons/upgrades/Gift of God.bmp"
	key="G"
	researchcommand="yes"
	groupverifier="data/subai/verify_research.vs"
	costgold = "1800"
	costfood = "0"
	execdelay = "20000"
	rollover="Regalo de Jupiter"
	description="Los nuevos soldados reclutados estaran equipados con un regalo de Jupiter que recuperara su vida cuando maten a su primer enemigo."
	method="research"
	param="ReqSet, Altar of Jupiter, default, NameSet, Regalo de Jupiter, default, SetsSet, items/Regalo de Jupiter, 1">
	<src obj="RTemple"/>
</cmd>

<cmd name="God's Gift2" priority="7"
	button="research/regalodemarte.bmp"
	queueicon="gameres/icons/upgrades/regalodemarte.bmp"
	key="G"
	researchcommand="yes"
	groupverifier="data/subai/verify_research.vs"
	costgold = "1800"
	costfood = "0"
	execdelay = "20000"
	rollover="Regalo de Marte"
	description="Los nuevos soldados reclutados estaran equipados con un regalo de Marte que aumenta su ataque hasta que maten a su primer enemigo."
	method="research"
	param="ReqSet, Altar of Jupiter, default, NameSet, Regalo de Marte, default, SetsSet, items/Regalo de Marte, 1">
	<src obj="MTemple"/>
</cmd>


</commands>
