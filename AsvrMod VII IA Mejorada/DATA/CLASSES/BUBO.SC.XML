	<properties icon="gameres/icons/buhomecanico.bmp"/>
	<properties sight="1000"/>
	<properties speed="200"/>
	<properties healthbar_type="0"/>
	<properties inventory_size="1"/>
	<properties damaged_by_ghost="0"/>

	<properties display_name="Bubo" display_name_plural="Buhos Mecanicos"/>
