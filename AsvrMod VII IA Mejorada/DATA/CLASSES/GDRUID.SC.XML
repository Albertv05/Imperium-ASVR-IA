<class id="GDruid" cpp_class="CVXDruid" parent="BaseMage" entity="Units/DLleldoryn/DLleldoryn.ent.xml">

	<properties race="Gaul"/>
	<properties maxhealth="120"/>
	<properties armor_slash="0" armor_pierce="0"/>
	<properties speed="50"/>
	<properties unit_specials="Sneak"/>

	<properties icon="gameres/icons/GDruid.bmp"/>
	<properties display_name="Druid" display_name_plural="Druids"/>
	<properties help="contents/units/GDruid"/>
	<properties edittree_pos="Units/Gaul/Druid"/>
	<sounds command="Sounds/entities/VoiceGDruid.xml"/>

	<method sig="stand_position"  vs="data/subai/2rpriest_stand_position.vs"/>
	<method sig="ondie"           vs="data/subai/druid_ondie.vs"/>
	<method sig="advance"         vs="data/subai/2rpriest_advance.vs"/>
	<method sig="idle"            vs="data/subai/2rpriest_idle.vs"/>
	<method sig="glearn"          vs="data/subai/druid_learn.vs"/>

	<method sig="revitalize"            vs="data/subai/druid_revitalize.vs" verify="data/subai/druid_revitalize_verify.vs"/>
	<method sig="revitalize"            vs="data/subai/druid_revitalize_ground.vs"/>
	<method sig="ghoul_summoning" vs="data/subai/druid_ghoul_summoning.vs"/>
	<method sig="eagle_summoning" vs="data/subai/druid_eagle_summoning.vs"/>
	<method sig="restoration"     vs="data/subai/druid_restoration.vs"/>
	<method sig="posesion"        vs="data/subai/posesion.vs"/>

	<defaultcmd target="Unit">
		<cmd name="revitalize"/>
	</defaultcmd>

	<defaultcmd target="Hero">
		<cmd name="attach"/>
	</defaultcmd>

	<defaultcmd target="ShipBattle">
		<cmd name="boardship"/>
		<cmd name="approach"/>
	</defaultcmd>

</class>
